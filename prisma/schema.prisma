generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Core Models
// ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String   @default("")
  email        String   @unique @default("")
  password     String   @default("")
  role         String   @default("staff")        // admin, staff, checkin, sender
  status       String   @default("active")       // active, disabled
  tokenVersion Int      @default(0)
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events        Event[]            @relation("EventCreator")
  operationLogs OperationLog[]     @relation("OperationAuthor")
  eventAccess   EventAssignment[]
  guestCheckins Checkin[]          @relation("CheckinOperator")
  sessions     Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([status])
  @@map("users")
}


model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  ipAddress String   @default("")
  email     String   @default("")
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model Event {
  id                 String  @id @default(cuid())
  name               String  @default("")
  client             String  @default("")
  clientPhone        String  @default("")
  date               String  @default("")
  time               String  @default("")
  location           String  @default("")
  status             String  @default("preparing") // preparing, active, ended, archived
  password           String  @default("")
  guests             Int     @default(0)
  confirmed          Int     @default(0)
  attended           Int     @default(0)
  notes              String  @default("")
  hasInteractivePage Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  createdById        String?
  createdBy          User?              @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  guestsList         Guest[]
  sendLogs           SendLog[]
  checkins           Checkin[]
  comments           Comment[]
  templates          Template[]
  operationLogs      OperationLog[]
  trashItems         TrashItem[]
  scheduledMessages  ScheduledMessage[]
  staffAccess        EventAssignment[]
  mediaAssets        MediaAsset[]

  @@index([createdById])
  @@index([status])
  @@index([date])
  @@map("events")
}

// Grants a non-admin user (staff, checkin, sender) access to one specific
// event. This is the actual event-isolation mechanism: without a row here
// (or being the creator, or admin), a user cannot see or touch the event's
// data. Admin bypasses this table entirely.
model EventAssignment {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String   @default("staff")  // role scoped to this event
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
  @@map("event_assignments")
}

model Guest {
  id           String  @id @default(cuid())
  eventId      String
  name         String  @default("")
  phone        String  @default("")
  email        String  @default("")
  companions   Int     @default(0)
  sendStatus   String  @default("pending")    // pending, sent, failed
  confirmed    String  @default("pending")    // pending, confirmed, unconfirmed
  attended     String  @default("pending")    // pending, attended, absent
  hasQR        Boolean @default(false)

  // ──── QR hardening ────
  // Random opaque token, rotated whenever the QR is reissued. Never the
  // row id — rotating invalidates any printed QR without touching
  // guestId, and a unique index makes collision impossible.
  qrToken      String?  @unique
  qrColor      String   @default("#000000")
  qrRevoked    Boolean  @default(false)
  qrGeneratedAt DateTime?
  qrRevokedAt  DateTime?

  notes      String   @default("")
  archivedAt DateTime?         // soft delete / archive
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkins Checkin[]
  sendLogs SendLog[]
  editLogs GuestEditLog[]
  qrUsages QrUsage[]

  // PERFORMANCE (v10.8): compound indexes for the hot query paths.
  // - (eventId, confirmed, archivedAt): /api/stats confirmation counts,
  //   /api/guests status filter, /api/guests/[id] PATCH recount.
  // - (eventId, attended): /api/checkin attendedCount recount,
  //   /api/stats attendanceRate.
  // - (eventId, hasQR, qrRevoked): /api/stats qrUsageRate,
  //   /api/site-sync qr count.
  // The existing (eventId) and (archivedAt) single-column indexes stay
  // — they're useful for queries that only filter on one column.
  @@index([eventId])
  @@index([eventId, phone])
  @@index([eventId, name])
  @@index([eventId, confirmed, archivedAt])
  @@index([eventId, attended])
  @@index([eventId, hasQR, qrRevoked])
  @@index([archivedAt])
  @@map("guests")
}

model GuestEditLog {
  id        String   @id @default(cuid())
  guestId   String
  eventId   String
  field     String   @default("")
  oldValue  String   @default("")
  newValue  String   @default("")
  userId    String?
  user      String   @default("النظام")
  time      DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([eventId])
  @@index([time])
  @@map("guest_edit_logs")
}

model QrUsage {
  id        String   @id @default(cuid())
  guestId   String
  eventId   String
  action    String   @default("scan")         // scan, verify, issue, revoke, rotate
  success   Boolean  @default(true)
  reason    String   @default("")
  actorUserId String?
  actorName   String  @default("")
  ipAddress String   @default("")
  userAgent String   @default("")
  time      DateTime @default(now())

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([eventId])
  @@index([time])
  @@index([action])
  @@map("qr_usages")
}

model Checkin {
  id         String   @id @default(cuid())
  eventId    String
  guestId    String
  guestName  String   @default("")
  companions Int      @default(0)
  method     String   @default("manual")  // qr, manual
  // operatorName is a denormalised snapshot; operatorId is the authoritative
  // staff id from the session and must never come from the request body.
  operatorId String?
  operator   String   @default("")
  time       DateTime @default(now())

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest    Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  operatorRelation User? @relation("CheckinOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  // One check-in per guest across all events. Real protection against
  // double scans comes from the transaction in /api/checkin, but the
  // unique index is the backstop at the database level.
  @@unique([guestId])
  @@index([eventId])
  @@index([time])
  @@index([operatorId])
  @@map("checkins")
}

model SendLog {
  id         String   @id @default(cuid())
  eventId    String
  guestId    String?
  recipient  String   @default("")
  type       String   @default("invite")      // invite, reminder, final_reminder, thank_you
  channel    String   @default("whatsapp")    // whatsapp, email, both
  status     String   @default("pending")     // pending, sent, failed
  failReason String   @default("")
  time       DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest Guest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([guestId])
  @@index([time])
  @@index([status])
  // PERFORMANCE (v10.8): compound index for /api/stats channel+status
  // counts (4 count queries per /api/stats call hit this combination).
  @@index([eventId, channel, status])
  @@map("send_logs")
}

model Comment {
  id        String   @id @default(cuid())
  eventId   String
  guestName String   @default("")
  text      String   @default("")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@map("comments")
}

model Template {
  id        String   @id @default(cuid())
  eventId   String?
  name      String   @default("")
  type      String   @default("invite")  // invite, reminder, thank_you, custom
  text      String   @default("")
  // Design editor state (canvas-style invitation editor). JSON with
  // background, palette, fonts, image refs, positionable elements.
  design    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([type])
  @@map("templates")
}

model TrashItem {
  id          String   @id @default(cuid())
  eventId     String?
  name        String   @default("")
  itemType    String   @default("other")    // guest, event, template, other
  eventRef    String   @default("")
  createdById String?
  deletedAt   DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("trash_items")
}

model OperationLog {
  id        String   @id @default(cuid())
  eventId   String?
  text      String   @default("")
  userId    String?
  user      String   @default("النظام")
  // Optional structured before/after for audit-grade change history.
  entity    String   @default("")
  entityId  String   @default("")
  action    String   @default("")
  oldValue  String   @default("")
  newValue  String   @default("")
  ipAddress String   @default("")
  time      DateTime @default(now())

  event   Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator User?  @relation("OperationAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([time])
  @@index([entity, entityId])
  @@map("operation_logs")
}

model ScheduledMessage {
  id            String   @id @default(cuid())
  eventId       String
  recipientType String   @default("all")
  channel       String   @default("whatsapp")
  content       String   @default("{}")        // JSON
  templateId    String?
  guestIds      String   @default("[]")        // JSON array
  scheduleAt    DateTime
  status        String   @default("pending")   // pending, sent, failed, cancelled
  result        String   @default("")
  createdAt     DateTime @default(now())
  executedAt    DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status, scheduleAt])
  // PERFORMANCE (v10.8): the scheduler cron job queries
  // `WHERE status='pending' AND scheduleAt <= now` — the existing
  // (status, scheduleAt) index covers this. No new index needed.
  @@map("scheduled_messages")
}


model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  deviceName  String   @default("")
  userAgent   String   @default("")
  ipAddress   String   @default("")
  lastActive  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model MediaAsset {
  id        String   @id @default(cuid())
  eventId   String
  title     String   @default("")
  type      String   @default("video") // video, image
  url       String
  size      String   @default("")
  storage   String   @default("external")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([type])
  // PERFORMANCE (v10.8): /api/invitations fetches the latest video
  // for an event with `WHERE eventId=? AND type='video' ORDER BY
  // createdAt DESC LIMIT 1`. The compound index covers both the filter
  // and the sort.
  @@index([eventId, type, createdAt])
  @@map("media_assets")
}

// Integration configurations (WhatsApp, Cloudinary, Resend, Firebase, Robot).
// Stored in DB so admins can configure integrations from the dashboard
// without editing env files. Sensitive values (API keys, tokens) are stored
// as-is — in production you should encrypt these columns at rest.
model IntegrationConfig {
  id        String   @id @default(cuid())
  key       String   @unique                       // cloudinary, whatsapp, resend, firebase, robot
  label     String   @default("")
  config    String   @default("{}")                // JSON: { FIELD_NAME: "value", ... }
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("integration_configs")
}
